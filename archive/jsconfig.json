{
	"compilerOptions": {
		"checkJs": true,
		"module": "ES2020",
		"target": "ES2020",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": false,
		"noUnusedParameters": false,
		"noUnusedLocals": false,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"paths": {
			"*": [
				"./src/*"
			],
		},
		"types": [
			"vite/client"
		]
	},
	"include": [
		"src",
		"declarations.d.ts"
	],
	"exclude": [
		"node_modules",
	]
}