{
	"compilerOptions": {
		"checkJs": true,
		"module": "ES2020",
		"target": "ES2020",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": false,
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"src/*"
			]
		}
	},
	"include": [
		"src",
		"declarations.d.ts"
	],
	"exclude": [
		"node_modules",
	],
}